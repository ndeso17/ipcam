<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fitsSystemWindows="true">

    <!-- Full-bleed camera preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Floating status chips (Maps-style) -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvFpsInfo"
                style="@style/InfoText"
                android:text="FPS 20" />

            <TextView
                android:id="@+id/tvQualityInfo"
                style="@style/InfoText"
                android:layout_marginStart="8dp"
                android:text="Quality High" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnTogglePanel"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_status_chip"
                android:src="@android:drawable/arrow_up_float"
                android:contentDescription="Expand controls"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:elevation="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvIpInfo"
            style="@style/InfoText"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp"
            android:maxLines="2"
            android:text="Stream offline" />

        <TextView
            android:id="@+id/tvUsbStatus"
            style="@style/InfoText"
            android:layout_marginTop="6dp"
            android:text="USB --" />
    </LinearLayout>

    <!-- Bottom sheet: peek = Start/Stop only -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_sheet"
        android:elevation="16dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_peekHeight="108dp"
        app:behavior_hideable="false"
        app:behavior_fitToContents="true"
        app:behavior_skipCollapsed="false">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_sheet_handle" />

<!-- Peek row: FrameLayout with centered shutter -->
        <FrameLayout
            android:id="@+id/layoutStartStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false">

            <!-- Left buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnMicToggle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:src="@drawable/ic_mic"
                    android:contentDescription="Mic"
                    android:scaleType="centerInside"
                    android:padding="8dp" />

                <ImageButton
                    android:id="@+id/btnSwitchCamera"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:src="@drawable/ic_flip"
                    android:contentDescription="Flip camera"
                    android:scaleType="centerInside"
                    android:padding="8dp" />

                <ImageButton
                    android:id="@+id/btnOrientationLock"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:src="@drawable/ic_rotate"
                    android:contentDescription="Lock orientation"
                    android:scaleType="centerInside"
                    android:padding="8dp" />
            </LinearLayout>

            <!-- Centered shutter -->
            <FrameLayout
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_btn_record_off"
                    android:id="@+id/btnRecordBg" />

                <View
                    android:id="@+id/btnRecordInner"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_btn_record_inner"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Right equalizer -->
            <com.example.ipcam.EqualizerView
                android:id="@+id/equalizerView"
                android:layout_width="60dp"
                android:layout_height="32dp"
                android:layout_gravity="end|center_vertical"
                android:visibility="invisible" />
        </FrameLayout>

        <!-- Expanded controls -->
        <LinearLayout
            android:id="@+id/expandedControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#22FFFFFF"
                android:layout_marginBottom="16dp" />

            <TextView
                style="@style/SheetLabel"
                android:text="QUALITY" />

            <LinearLayout
                android:id="@+id/layoutQuality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnDecreaseQuality"
                    style="@style/ControlButton"
                    android:layout_width="56dp"
                    android:layout_height="44dp"
                    android:text="−"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvQualityValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="High"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnIncreaseQuality"
                    style="@style/ControlButton"
                    android:layout_width="56dp"
                    android:layout_height="44dp"
                    android:text="+"
                    android:textSize="22sp" />
            </LinearLayout>

            <TextView
                style="@style/SheetLabel"
                android:text="FPS" />

            <LinearLayout
                android:id="@+id/layoutFps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnDecreaseFps"
                    style="@style/ControlButton"
                    android:layout_width="56dp"
                    android:layout_height="44dp"
                    android:text="−"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvFpsValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="20"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnIncreaseFps"
                    style="@style/ControlButton"
                    android:layout_width="56dp"
                    android:layout_height="44dp"
                    android:text="+"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
