<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayFilterMenu"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:visibility="gone">

    <!-- Filter chips container -->
    <LinearLayout
        android:id="@+id/filterChipsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/chipNone"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_filter_chip"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="None"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/chipBeauty"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_filter_chip"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Beauty"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/chipFaceBlur"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_filter_chip"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Face Blur"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/chipBgReplace"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_filter_chip"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="BG Replace"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/chipSepia"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_filter_chip"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Sepia"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/chipGrayscale"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_filter_chip"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Grayscale"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/chipNegative"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_filter_chip"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Negative"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/chipVignette"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_filter_chip"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Vignette"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/chipBrightness"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_filter_chip"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Brightness"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/chipContrast"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_filter_chip"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Contrast"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/chipSaturation"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_filter_chip"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Saturation"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/chipGlow"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_filter_chip"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Glow"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/chipSketch"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_filter_chip"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Sketch"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/chipToon"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_filter_chip"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Toon"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/chipPixelate"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_filter_chip"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Pixelate"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/chipKaleidoscope"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_filter_chip"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Kaleidoscope"
            android:textColor="@color/white" />
    </LinearLayout>

    <!-- Filter toggle button -->
    <ImageButton
        android:id="@+id/btnFilterToggle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_filter_fab"
        android:src="@drawable/ic_filter"
        android:scaleType="centerInside"
        android:elevation="4dp"
        android:padding="8dp" />

</FrameLayout>